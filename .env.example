# Copie para .env e preencha. O .env nunca entra no git.
# Chave da API do Gemini, criada no Google AI Studio
GEMINI_API_KEY=
# Modelo principal. Vazio usa gemini-flash-latest
GEMINI_MODEL=
# Modelo de reserva, usado quando o principal falha. Vazio usa gemini-3.1-flash-lite
GEMINI_MODEL_RESERVA=
# Chave só para testes (test/mari-dialogos.mjs, test/metricas.mjs e test/metricas-crise-completa.mjs), separada da de
# produção. Os testes que chamam o Gemini leem só esta variável e param sem ela; a chave de produção nunca é usada
# nos testes. Os scripts não leem o .env: defina-a no ambiente do terminal ao rodar
GEMINI_API_KEY_TESTES=
